# Copy to .env before starting the backend.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Replace the placeholder locally with the current database password.
# Percent-encode special characters in the password when placing it in this URL.
# Hostinger remote MySQL uses port 3306; authenticated setup check passed.
DATABASE_URL="mysql://u472333726_social:@1706SakshiK@srv1275.hstgr.io:3306/u472333726_socialmedia"

FIREBASE_PROJECT_ID=social-media-ff4bc
# Absolute path to the private Firebase Admin JSON file on your computer.
# Keep it outside the repository, or name it backend/firebase-admin.json (ignored).
GOOGLE_APPLICATION_CREDENTIALS="D:/GitHub/SocialMediaOperationsSystem/backend/firebase-admin.json"

# Intended first Agency user; provisioning will be an explicit setup action.
BOOTSTRAP_AGENCY_NAME="Sagar Kumar"
BOOTSTRAP_AGENCY_EMAIL="agency@gmail.com"

# ---- Hosting (Railway, Render, ...) ----
# FRONTEND_ORIGIN may list several website addresses separated by commas, e.g. https://app.example.com,https://my-app.up.railway.app
# HOST defaults to 0.0.0.0 when NODE_ENV=production, otherwise 127.0.0.1.
# TRUST_PROXY defaults to 1 in production (one proxy in front of the server).
# On a host there is no key file: paste the Firebase Admin JSON as base64 instead (see DEPLOY-RAILWAY.md).
# FIREBASE_SERVICE_ACCOUNT_BASE64=
